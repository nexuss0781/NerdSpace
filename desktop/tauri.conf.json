{
  "productName": "Nexus Desktop",
  "version": "0.1.1",
  "identifier": "com.nexus.desktop",
  "build": {
    "frontendDist": "./dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Nexus Desktop",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: 'unsafe-inline' 'unsafe-eval' data: http: https: ws: wss:; img-src 'self' data: tauri: https: http: blob:; font-src 'self' data:; connect-src 'self' tauri: http: https: ws: wss:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "identifier": "com.nexus.desktop",
    "resources": [],
    "externalBin": [],
    "copyright": "Copyright © 2026 Nexus",
    "category": "DeveloperTool",
    "shortDescription": "Wrap websites and manage projects/files on your desktop",
    "longDescription": "Nexus Desktop turns any website into a desktop app and gives you a real-time file/project manager with full CRUD over your root folder and its projects.",
    "deb": {
      "depends": []
    },
    "macos": {
      "frameworks": [],
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": "entitlements.plist",
      "minorVersion": null,
      "majorVersion": null,
      "publishUrl": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": "fixed",
      "webviewVersion": ""
    }
  }
}
